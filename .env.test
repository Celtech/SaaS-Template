# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
APP_NAME='Test App'
BILLING_ENABLED=false
PLAN_TOKEN_SECRET=test-plan-token-secret
STRIPE_WEBHOOK_SECRET=whsec_phpunit_test_webhook_secret_do_not_use_in_production
WEBHOOK_SECRET_ENCRYPTION_KEY=abababababababababababababababababababababababababababababababab

# RateLimiterFactory resolves its 'limit' config eagerly at construction time, so any
# service that injects it (e.g. RegistrationController, PasswordResetController) needs
# this to be a valid int even in requests/tests that never actually call ->consume().
# RateLimitingTest asserts the 6th attempt in a test method gets a 429, so keep this at 5.
AUTH_RATE_LIMIT_REGISTER_PER_HOUR=5
AUTH_RATE_LIMIT_FORGOT_PASSWORD_PER_HOUR=5
