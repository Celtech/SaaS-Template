###> Core ###
APP_ENV=dev
APP_SECRET=REQUIRED_generate_with_make_secret
APP_DEBUG=1
###< Core ###

###> Database ###
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?serverVersion=VERSION&charset=utf8
DATABASE_URL="postgresql://app:secret@db:5432/saas_template?serverVersion=17&charset=utf8"
POSTGRES_PASSWORD=secret
###< Database ###

###> Valkey (Redis-compatible queue/cache) ###
MESSENGER_TRANSPORT_DSN=redis://valkey:6379/messages
SCHEDULER_DSN=redis://valkey:6379/scheduler
# Production: include password — redis://:PASSWORD@host:6379/messages
VALKEY_PASSWORD=REQUIRED_in_production
###< Valkey ###

###> Mailer ###
# Development: uses Mailpit (http://localhost:8025)
MAILER_DSN=smtp://mailpit:1025
# Production (ZeptoMail): smtp://YOUR_TOKEN@smtppro.zoho.in:587
# MAILER_DSN=smtp://YOUR_ZEPTOMAIL_SMTP_TOKEN@smtppro.zoho.in:587
MAILER_FROM_ADDRESS=noreply@yourdomain.com
MAILER_FROM_NAME="Your App Name"
###< Mailer ###

###> Stripe ###
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=REQUIRED_sk_test_or_sk_live
STRIPE_PUBLISHABLE_KEY=REQUIRED_pk_test_or_pk_live
# Get this from https://dashboard.stripe.com/webhooks after creating an endpoint
STRIPE_WEBHOOK_SECRET=REQUIRED_whsec_
###< Stripe ###

###> Server ###
SERVER_NAME="localhost, :80"
# Used for generating absolute URLs in CLI commands (e.g., email links)
DEFAULT_URI=https://localhost
LOG_LEVEL=DEBUG
###< Server ###
