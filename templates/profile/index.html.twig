{% extends 'layouts/app.html.twig' %}
{% import 'form/field.html.twig' as forms %}

{% block title %}Profile{% endblock %}

{% block main %}
<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-semibold text-foreground">Profile</h1>
        <p class="mt-1 text-sm text-muted-foreground">Manage your account information</p>
    </div>

    <div class="grid grid-cols-[200px_1fr] gap-8">
        {% include 'profile/_tabs.html.twig' with {active: 'general'} %}

        <div class="min-w-0 space-y-5">
            <div class="rounded-[10px] border border-border p-6">
                <h2 class="mb-[18px] text-[15px] font-semibold text-foreground">Profile information</h2>

                <div class="mb-5 flex items-center gap-4">
                    <twig:Avatar fallback="{{ app.user.email|slice(0,2) }}" size="lg" />
                </div>

                {{ form_start(form, {'action': path('profile_update'), 'method': 'post', 'attr': {'class': 'space-y-3.5', 'novalidate': true}}) }}

                    {{ forms.field(form.name) }}
                    <div>
                        {{ forms.field(form.email) }}
                        {% if not user.emailVerified %}
                            <p class="mt-1 text-xs text-warning">Email not yet verified.</p>
                        {% endif %}
                    </div>

                    <div class="flex justify-end pt-1.5">
                        <button type="submit" class="rounded-md bg-primary px-[18px] py-[9px] text-[13px] font-medium text-primary-foreground hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2">
                            Save changes
                        </button>
                    </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock main %}
