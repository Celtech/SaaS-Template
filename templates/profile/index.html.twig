{% extends 'layouts/app.html.twig' %}
{% import 'form/field.html.twig' as forms %}

{% block title %}Profile{% endblock %}

{% block main %}
<div class="max-w-2xl space-y-6">
    <div>
        <h1 class="text-2xl font-semibold text-foreground">Profile</h1>
        <p class="mt-1 text-sm text-muted-foreground">Manage your account information</p>
    </div>

    <div class="flex gap-4 border-b text-sm">
        <a href="{{ path('profile_index') }}" class="border-b-2 border-primary pb-3 font-medium text-foreground">
            General
        </a>
        <a href="{{ path('profile_security') }}" class="pb-3 text-muted-foreground hover:text-foreground">
            Security
        </a>
        <a href="{{ path('profile_notifications') }}" class="pb-3 text-muted-foreground hover:text-foreground">
            Notifications
        </a>
    </div>

    <div class="rounded-xl border bg-card p-6 shadow-sm">
        {{ form_start(form, {'action': path('profile_update'), 'method': 'post', 'attr': {'class': 'space-y-4', 'novalidate': true}}) }}

            {{ forms.field(form.name) }}
            <div>
                {{ forms.field(form.email) }}
                {% if not user.emailVerified %}
                    <p class="mt-1 text-xs text-warning">Email not yet verified.</p>
                {% endif %}
            </div>

            <div class="flex justify-end">
                <button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2">
                    Save changes
                </button>
            </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock main %}
