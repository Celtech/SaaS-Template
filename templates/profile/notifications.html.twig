{% extends 'layouts/app.html.twig' %}
{% block title %}Notification preferences{% endblock %}

{% block main %}
<div class="max-w-3xl space-y-6">
    <div>
        <h1 class="text-2xl font-semibold text-foreground">Profile</h1>
        <p class="mt-1 text-sm text-muted-foreground">Manage your account information</p>
    </div>

    <div class="grid grid-cols-[200px_1fr] gap-8">
        {% include 'profile/_tabs.html.twig' with {active: 'notifications'} %}

        <div class="min-w-0">
    <div class="rounded-[10px] border border-border p-6">
        <h2 class="mb-1 text-[15px] font-semibold text-foreground">Notification preferences</h2>
        <p class="mb-4 text-sm text-muted-foreground">Choose which notifications you receive and how.</p>

        <form method="POST" action="{{ path('profile_notifications_update') }}" class="space-y-4">
            <input type="hidden" name="_token" value="{{ csrf_token('profile_notifications') }}">

            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b">
                        <th class="py-2 text-left font-medium text-muted-foreground">Notification</th>
                        <th class="w-24 py-2 text-center font-medium text-muted-foreground">In-app</th>
                        <th class="w-24 py-2 text-center font-medium text-muted-foreground">Email</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    {% for type in types %}
                        <tr>
                            <td class="py-3 text-foreground">{{ type.description }}</td>
                            <td class="py-3 text-center">
                                {% if 'in_app' in type.supportedChannels %}
                                    <input type="checkbox" name="preferences[{{ type.value }}][in_app]" value="1"
                                           {{ state[type.value]['in_app'] ? 'checked' : '' }}
                                           class="h-4 w-4 rounded border-input text-primary focus:ring-ring">
                                {% else %}
                                    <span class="text-muted-foreground">—</span>
                                {% endif %}
                            </td>
                            <td class="py-3 text-center">
                                {% if 'email' in type.supportedChannels %}
                                    <input type="checkbox" name="preferences[{{ type.value }}][email]" value="1"
                                           {{ state[type.value]['email'] ? 'checked' : '' }}
                                           class="h-4 w-4 rounded border-input text-primary focus:ring-ring">
                                {% else %}
                                    <span class="text-muted-foreground">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <div class="flex justify-end">
                <button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2">
                    Save changes
                </button>
            </div>
        </form>
    </div>
        </div>
    </div>
</div>
{% endblock %}
