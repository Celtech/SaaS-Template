{% extends 'layouts/app.html.twig' %}

{% block title %}Add security key{% endblock %}

{% block main %}
<div class="max-w-2xl space-y-6">
    <div>
        <h1 class="text-2xl font-semibold text-foreground">Add security key</h1>
        <p class="mt-1 text-sm text-muted-foreground">Register a hardware key, fingerprint, or Face ID as a sign-in method</p>
    </div>

    <div class="rounded-xl border bg-card p-6 shadow-sm">
        <form method="post" action="{{ path('profile_webauthn_register_save') }}" id="register-form" class="space-y-5">
            <input type="hidden" name="_token" value="{{ csrf_token('webauthn_register') }}">
            <input type="hidden" name="response" id="webauthn-response">

            <div class="space-y-1">
                <label for="name" class="block text-sm font-medium text-foreground">Key name</label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    maxlength="100"
                    placeholder="e.g. YubiKey, MacBook Touch ID, iPhone Face ID"
                    class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
                    autofocus
                >
                <p class="text-xs text-muted-foreground">A name to help you identify this key later.</p>
            </div>

            <div id="register-status" class="hidden rounded-lg border bg-muted/40 px-4 py-5 text-center text-sm">
                <p id="status-text" class="text-muted-foreground">Waiting for your security key…</p>
            </div>

            <div class="flex items-center gap-3">
                <button
                    type="button"
                    id="register-btn"
                    class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
                >
                    Register key
                </button>
                <a href="{{ path('profile_security') }}" class="text-sm text-muted-foreground hover:text-foreground">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<script>
(function () {
    var optionsJson = {{ optionsJson|raw }};

    function b64urlDecode(str) {
        var base64 = str.replace(/-/g, '+').replace(/_/g, '/');
        var padded = base64.padEnd(base64.length + (4 - base64.length % 4) % 4, '=');
        return Uint8Array.from(atob(padded), function (c) { return c.charCodeAt(0); }).buffer;
    }

    function b64urlEncode(buffer) {
        return btoa(String.fromCharCode.apply(null, new Uint8Array(buffer)))
            .replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
    }

    function setStatus(msg, isError) {
        var el = document.getElementById('register-status');
        var text = document.getElementById('status-text');
        el.classList.remove('hidden');
        text.textContent = msg;
        text.className = isError ? 'text-destructive' : 'text-muted-foreground';
    }

    document.getElementById('register-btn').addEventListener('click', async function () {
        var name = document.getElementById('name').value.trim();
        if (!name) {
            document.getElementById('name').focus();
            return;
        }

        if (!window.PublicKeyCredential) {
            setStatus('Your browser does not support security keys.', true);
            return;
        }

        setStatus('Waiting for your security key…', false);

        var options = JSON.parse(JSON.stringify(optionsJson));
        options.challenge = b64urlDecode(options.challenge);
        options.user.id = b64urlDecode(options.user.id);
        if (options.excludeCredentials) {
            options.excludeCredentials = options.excludeCredentials.map(function (c) {
                return Object.assign({}, c, { id: b64urlDecode(c.id) });
            });
        }

        try {
            var credential = await navigator.credentials.create({ publicKey: options });
            var response = {
                id: credential.id,
                rawId: b64urlEncode(credential.rawId),
                type: credential.type,
                response: {
                    clientDataJSON: b64urlEncode(credential.response.clientDataJSON),
                    attestationObject: b64urlEncode(credential.response.attestationObject),
                    transports: credential.response.getTransports ? credential.response.getTransports() : []
                }
            };
            document.getElementById('webauthn-response').value = JSON.stringify(response);
            setStatus('Key registered — saving…', false);
            document.getElementById('register-form').submit();
        } catch (err) {
            if (err.name === 'NotAllowedError') {
                setStatus('Key registration was cancelled or timed out.', true);
            } else {
                setStatus('Registration failed: ' + err.message, true);
            }
        }
    });
})();
</script>
{% endblock %}
