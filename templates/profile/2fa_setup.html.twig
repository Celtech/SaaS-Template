{% extends 'layouts/app.html.twig' %}

{% block title %}Set up two-factor authentication{% endblock %}

{% block main %}
<div class="max-w-2xl space-y-6">
    <div>
        <h1 class="text-2xl font-semibold text-foreground">Set up two-factor authentication</h1>
        <p class="mt-1 text-sm text-muted-foreground">
            Scan the QR code with your authenticator app, then enter the 6-digit code to confirm.
        </p>
    </div>

    {% for message in app.flashes('error') %}
        <div class="rounded-lg bg-destructive/10 px-4 py-3 text-sm text-destructive">{{ message }}</div>
    {% endfor %}

    <div class="rounded-[10px] border border-border p-6 space-y-6">

        {# Step 1: QR code #}
        <div>
            <p class="mb-3 text-sm font-medium text-card-foreground">
                1. Scan this QR code with Google Authenticator, Authy, or any TOTP app
            </p>
            <div class="flex justify-center">
                <img
                    src="{{ qr_code_uri }}"
                    alt="TOTP QR code"
                    width="300"
                    height="300"
                    class="rounded-md border p-2"
                >
            </div>
        </div>

        {# Step 2: Manual key #}
        <div>
            <p class="mb-2 text-sm font-medium text-card-foreground">
                2. Or enter this key manually
            </p>
            <div class="min-w-0 overflow-hidden rounded-md border bg-muted px-3 py-2">
                <code class="block min-w-0 break-all font-mono text-sm leading-relaxed text-foreground">{{ totp_secret }}</code>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">Time-based · SHA-1 · 6 digits · 30 seconds</p>
        </div>

        {# Step 3: Confirm #}
        <div>
            <p class="mb-3 text-sm font-medium text-card-foreground">
                3. Enter the 6-digit code from your app to confirm
            </p>
            <form method="post" action="{{ path('profile_2fa_enable') }}" class="space-y-4">
                <input type="hidden" name="_token" value="{{ csrf_token('2fa_enable') }}">
                <input
                    type="text"
                    name="code"
                    inputmode="numeric"
                    pattern="[0-9]{6}"
                    maxlength="6"
                    autocomplete="one-time-code"
                    autofocus
                    required
                    placeholder="000000"
                    class="w-full rounded-md border border-input bg-background px-3 py-2 text-center text-lg tracking-widest focus:outline-none focus:ring-2 focus:ring-ring"
                >
                <div class="flex flex-col gap-3 sm:flex-row">
                    <button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 sm:flex-1">
                        Enable two-factor authentication
                    </button>
                    <a href="{{ path('profile_security') }}" class="rounded-md border px-4 py-2 text-center text-sm font-medium text-foreground hover:bg-muted">
                        Cancel
                    </a>
                </div>
            </form>
        </div>

    </div>
</div>
{% endblock %}
