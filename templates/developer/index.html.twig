{% extends 'layouts/app.html.twig' %}

{% block title %}Developer{% endblock %}

{% block main %}
<div class="max-w-4xl mx-auto space-y-8">
    <div>
        <h1 class="text-2xl font-semibold text-foreground">Developer</h1>
        <p class="mt-1 text-sm text-muted-foreground">Integrate your applications with the API using OAuth 2.0.</p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <a href="{{ path('developer_apps_index') }}"
           class="group flex flex-col gap-3 rounded-lg border border-border bg-card p-6 transition-colors hover:border-primary/50">
            <div class="flex items-center gap-3">
                <div class="rounded-md bg-muted p-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
                </div>
                <h2 class="text-base font-medium text-foreground group-hover:text-primary">OAuth Applications</h2>
            </div>
            <p class="text-sm text-muted-foreground">Register and manage OAuth 2.0 clients to authenticate your integrations.</p>
        </a>

        <div class="flex flex-col gap-3 rounded-lg border border-border bg-card p-6 opacity-50">
            <div class="flex items-center gap-3">
                <div class="rounded-md bg-muted p-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </div>
                <h2 class="text-base font-medium text-foreground">Webhooks <span class="ml-1 text-xs text-muted-foreground">(coming soon)</span></h2>
            </div>
            <p class="text-sm text-muted-foreground">Send real-time event notifications to your endpoints via HMAC-signed webhooks.</p>
        </div>
    </div>

    <div class="rounded-lg border border-border bg-card p-6 space-y-4">
        <h2 class="text-base font-medium text-foreground">Quick start</h2>
        <div class="space-y-3 text-sm text-muted-foreground">
            <div class="flex gap-3">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-semibold text-primary">1</span>
                <span>Create an OAuth application and select the grant types your integration needs.</span>
            </div>
            <div class="flex gap-3">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-semibold text-primary">2</span>
                <span>Use your <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">client_id</code> and <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">client_secret</code> to request a Bearer token from <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">/oauth/token</code>.</span>
            </div>
            <div class="flex gap-3">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-semibold text-primary">3</span>
                <span>Include the token in the <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">Authorization: Bearer &lt;token&gt;</code> header on every API request.</span>
            </div>
        </div>
        <div class="pt-2">
            <a href="{{ path('oauth_discovery') }}" target="_blank"
               class="text-sm text-primary hover:underline">
                View OAuth discovery document →
            </a>
        </div>
    </div>
</div>
{% endblock %}
