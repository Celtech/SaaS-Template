{% extends 'layouts/app.html.twig' %}

{% block title %}{{ endpoint.url }}{% endblock %}

{% block main %}
<div class="max-w-5xl space-y-6">
    <div class="flex items-start justify-between">
        <div>
            <a href="{{ path('developer_webhooks_index') }}" class="text-sm text-muted-foreground hover:text-foreground">← Webhooks</a>
            <h1 class="mt-2 text-2xl font-semibold text-foreground break-all">{{ endpoint.url }}</h1>
        </div>
        <div class="flex shrink-0 items-center gap-2">
            <a href="{{ path('developer_webhooks_edit', {id: endpoint.id}) }}"
               class="rounded-md border border-border px-3 py-1.5 text-sm font-medium text-foreground hover:bg-muted transition-colors">
                Edit
            </a>
            <form method="POST" action="{{ path('developer_webhooks_delete', {id: endpoint.id}) }}"
                  onsubmit="return confirm('Delete this webhook endpoint? This cannot be undone.');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_webhook_' ~ endpoint.id) }}">
                <button type="submit" class="rounded-md border border-destructive/40 px-3 py-1.5 text-sm font-medium text-destructive hover:bg-destructive/10 transition-colors">
                    Delete
                </button>
            </form>
        </div>
    </div>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="rounded-md px-4 py-3 text-sm
                {{ type == 'error' ? 'bg-destructive/10 text-destructive' :
                   type == 'warning' ? 'bg-yellow-50 text-yellow-800 dark:bg-yellow-900/20 dark:text-yellow-400' :
                                       'bg-green-50 text-green-800 dark:bg-green-900/20 dark:text-green-400' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {% if plainSecret is not null %}
        <div class="rounded-lg border border-yellow-300 bg-yellow-50 p-4 dark:border-yellow-900/50 dark:bg-yellow-900/20">
            <p class="text-sm font-medium text-yellow-800 dark:text-yellow-400">Save your signing secret — it won't be shown again.</p>
            <code class="mt-2 block rounded bg-yellow-100 px-3 py-2 font-mono text-sm text-yellow-900 break-all dark:bg-yellow-950/40 dark:text-yellow-300">{{ plainSecret }}</code>
        </div>
    {% endif %}

    <div class="rounded-lg border border-border bg-card p-6 space-y-4">
        <h2 class="text-base font-medium text-foreground">Configuration</h2>
        <dl class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
            <div>
                <dt class="text-muted-foreground">Status</dt>
                <dd class="mt-1">
                    {% if endpoint.active %}
                        <span class="inline-flex rounded-full bg-green-600 px-2 py-0.5 text-xs text-white">Active</span>
                    {% else %}
                        <span class="inline-flex rounded-full bg-muted px-2 py-0.5 text-xs text-muted-foreground">Disabled</span>
                    {% endif %}
                </dd>
            </div>
            <div>
                <dt class="text-muted-foreground">Signing secret</dt>
                <dd class="mt-1 flex items-center gap-2">
                    <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-muted-foreground">••••{{ endpoint.displayHint }}</code>
                    <form method="POST" action="{{ path('developer_webhooks_regenerate_secret', {id: endpoint.id}) }}"
                          onsubmit="return confirm('Regenerate the signing secret? The previous secret will stop working immediately.');">
                        <input type="hidden" name="_token" value="{{ csrf_token('regenerate_webhook_secret_' ~ endpoint.id) }}">
                        <button type="submit" class="text-xs text-primary hover:underline">Regenerate</button>
                    </form>
                </dd>
            </div>
            <div class="col-span-2">
                <dt class="text-muted-foreground">Events</dt>
                <dd class="mt-1 flex flex-wrap gap-1">
                    {% for event in endpoint.events %}
                        <span class="inline-flex rounded-full bg-muted px-2 py-0.5 font-mono text-xs">{{ event }}</span>
                    {% endfor %}
                </dd>
            </div>
            <div>
                <dt class="text-muted-foreground">Created</dt>
                <dd class="mt-1 font-medium">{{ endpoint.createdAt|date('M j, Y') }}</dd>
            </div>
        </dl>
    </div>

    <div class="rounded-lg border border-border bg-card p-6 space-y-3">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-base font-medium text-foreground">Send a test event</h2>
                <p class="text-sm text-muted-foreground">Sends a sample payload to verify your endpoint and signature handling.</p>
            </div>
            <form method="POST" action="{{ path('developer_webhooks_test', {id: endpoint.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('test_webhook_' ~ endpoint.id) }}">
                <button type="submit" class="rounded-md border border-border px-4 py-2 text-sm font-medium text-foreground hover:bg-muted transition-colors">
                    Send Test Event
                </button>
            </form>
        </div>
    </div>

    <div class="rounded-[10px] border border-border overflow-hidden">
        <div class="border-b border-border px-4 py-3">
            <h2 class="text-[15px] font-semibold text-foreground">Delivery log</h2>
        </div>
        {% if deliveries is empty %}
            <p class="p-6 text-sm text-muted-foreground text-center">No deliveries yet.</p>
        {% else %}
            <table class="w-full text-[13px]">
                <thead>
                    <tr class="border-b border-border">
                        <th class="px-4 py-2.5 text-left font-medium text-muted-foreground">Event</th>
                        <th class="px-4 py-2.5 text-left font-medium text-muted-foreground">Status</th>
                        <th class="px-4 py-2.5 text-left font-medium text-muted-foreground">Attempts</th>
                        <th class="px-4 py-2.5 text-left font-medium text-muted-foreground">Last response</th>
                        <th class="px-4 py-2.5 text-left font-medium text-muted-foreground">Sent</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-muted">
                    {% for delivery in deliveries %}
                        <tr>
                            <td class="px-4 py-2.5 font-mono text-xs text-foreground">{{ delivery.eventType }}</td>
                            <td class="px-4 py-2.5">
                                {% set statusValue = delivery.status.value %}
                                <span class="inline-flex rounded-full px-2 py-0.5 text-[11px]
                                    {{ statusValue == 'success' ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400' :
                                       statusValue == 'pending' ? 'bg-muted text-muted-foreground' :
                                       statusValue == 'failed' ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400' :
                                                                  'bg-destructive/10 text-destructive' }}">
                                    {{ statusValue }}
                                </span>
                            </td>
                            <td class="px-4 py-2.5 text-muted-foreground">{{ delivery.attempts }}</td>
                            <td class="px-4 py-2.5 text-muted-foreground">{{ delivery.lastResponseCode ?? '—' }}</td>
                            <td class="px-4 py-2.5 text-muted-foreground">{{ delivery.createdAt|date('M j, Y H:i') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>
{% endblock %}
