{% extends 'layouts/app.html.twig' %}

{% block title %}Webhooks{% endblock %}

{% block main %}
<div class="max-w-5xl space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-foreground">Webhooks</h1>
            <p class="mt-1 text-sm text-muted-foreground">Send real-time event notifications to your endpoints.</p>
        </div>
        <a href="{{ path('developer_webhooks_new') }}"
           class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            New Endpoint
        </a>
    </div>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="rounded-md px-4 py-3 text-sm
                {{ type == 'error' ? 'bg-destructive/10 text-destructive' :
                   type == 'warning' ? 'bg-yellow-50 text-yellow-800 dark:bg-yellow-900/20 dark:text-yellow-400' :
                                       'bg-green-50 text-green-800 dark:bg-green-900/20 dark:text-green-400' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {% if endpoints is empty %}
        <div class="rounded-lg border border-dashed border-border bg-card p-12 text-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-10 w-10 text-muted-foreground/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a10 10 0 1 0 10 10"/><path d="M12 8v4l3 3"/></svg>
            <p class="mt-4 text-sm font-medium text-foreground">No webhook endpoints yet</p>
            <p class="mt-1 text-sm text-muted-foreground">Register an endpoint to start receiving event notifications.</p>
            <a href="{{ path('developer_webhooks_new') }}"
               class="mt-4 inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors">
                Create Endpoint
            </a>
        </div>
    {% else %}
        <div class="rounded-[10px] border border-border overflow-hidden">
            <table class="w-full text-[13px]">
                <thead>
                    <tr class="border-b border-border">
                        <th class="px-4 py-2.5 text-left font-medium text-muted-foreground">URL</th>
                        <th class="px-4 py-2.5 text-left font-medium text-muted-foreground">Events</th>
                        <th class="px-4 py-2.5 text-left font-medium text-muted-foreground">Status</th>
                        <th class="px-4 py-2.5 text-left font-medium text-muted-foreground">Created</th>
                        <th class="px-4 py-2.5"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-muted">
                    {% for endpoint in endpoints %}
                        <tr class="hover:bg-muted/30 transition-colors">
                            <td class="px-4 py-2.5 font-mono text-xs text-foreground">{{ endpoint.url }}</td>
                            <td class="px-4 py-2.5 text-muted-foreground">{{ endpoint.events|length }} event{{ endpoint.events|length != 1 ? 's' : '' }}</td>
                            <td class="px-4 py-2.5">
                                {% if endpoint.active %}
                                    <span class="inline-flex rounded-full bg-green-100 px-2 py-0.5 text-[11px] text-green-800 dark:bg-green-900/30 dark:text-green-400">Active</span>
                                {% else %}
                                    <span class="inline-flex rounded-full bg-muted px-2 py-0.5 text-[11px] text-muted-foreground">Disabled</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-2.5 text-muted-foreground">{{ endpoint.createdAt|date('M j, Y') }}</td>
                            <td class="px-4 py-2.5 text-right">
                                <a href="{{ path('developer_webhooks_show', {id: endpoint.id}) }}"
                                   class="text-sm text-primary hover:underline">Details</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
