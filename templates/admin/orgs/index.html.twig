{% extends 'layouts/admin.html.twig' %}
{% block title %}Organizations{% endblock %}

{% block admin_content %}
<div class="max-w-5xl space-y-6">
    <div>
        <h1 class="text-2xl font-semibold text-foreground">Organizations</h1>
        <p class="mt-1 text-sm text-muted-foreground">{{ total }} organization{{ total != 1 ? 's' : '' }} registered.</p>
    </div>

    <form method="GET" class="flex gap-2">
        <input type="text" name="q" value="{{ search }}" placeholder="Search by name…"
               class="flex-1 rounded-md border bg-background px-3 py-[7px] text-[13px] text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring">
        <button type="submit" class="rounded-md bg-primary px-4 py-[7px] text-[13px] font-medium text-primary-foreground hover:bg-primary/90">Search</button>
        {% if search %}
            <a href="{{ path('admin_orgs_index') }}" class="rounded-md border px-4 py-[7px] text-[13px] font-medium text-muted-foreground hover:bg-accent/50">Clear</a>
        {% endif %}
    </form>

    <div class="rounded-[10px] border border-border overflow-hidden">
        <table class="w-full text-[13px]">
            <thead>
                <tr class="border-b border-border">
                    <th class="px-4 py-2.5 text-left font-medium text-muted-foreground">Name</th>
                    <th class="px-4 py-2.5 text-left font-medium text-muted-foreground">Owner</th>
                    <th class="px-4 py-2.5 text-left font-medium text-muted-foreground">Created</th>
                    <th class="px-4 py-2.5 text-right font-medium text-muted-foreground">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-muted">
                {% for org in orgs %}
                <tr class="hover:bg-muted/30">
                    <td class="px-4 py-2.5 font-medium text-foreground">
                        <a href="{{ path('admin_orgs_show', {id: org.id}) }}" class="hover:underline">{{ org.name }}</a>
                    </td>
                    <td class="px-4 py-2.5 text-muted-foreground text-[13px]">
                        <a href="{{ path('admin_users_show', {id: org.owner.id}) }}" class="hover:underline">{{ org.owner.email }}</a>
                    </td>
                    <td class="px-4 py-2.5 text-xs text-muted-foreground">{{ org.createdAt|date('Y-m-d') }}</td>
                    <td class="px-4 py-2.5 text-right">
                        <a href="{{ path('admin_orgs_show', {id: org.id}) }}" class="text-xs text-muted-foreground hover:text-foreground">View</a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="4" class="px-4 py-8 text-center text-sm text-muted-foreground">
                        No organizations found{% if search %} matching "{{ search }}"{% endif %}.
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if totalPages > 1 %}
    <div class="flex items-center justify-between text-sm">
        <p class="text-muted-foreground">
            Showing {{ ((page - 1) * perPage) + 1 }}–{{ min(page * perPage, total) }} of {{ total }}
        </p>
        <div class="flex gap-2">
            {% if page > 1 %}
                <a href="{{ path('admin_orgs_index', {page: page - 1, q: search}) }}"
                   class="rounded-md border px-3 py-1.5 text-muted-foreground hover:bg-accent/50">Previous</a>
            {% endif %}
            {% if page < totalPages %}
                <a href="{{ path('admin_orgs_index', {page: page + 1, q: search}) }}"
                   class="rounded-md border px-3 py-1.5 text-muted-foreground hover:bg-accent/50">Next</a>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
