{% extends 'layouts/admin.html.twig' %}
{% block title %}Confirm Identity{% endblock %}

{% block admin_content %}
<div class="mx-auto max-w-md space-y-6">
    <div>
        <h1 class="text-2xl font-semibold text-foreground">Confirm your identity</h1>
        <p class="mt-1 text-sm text-muted-foreground">Re-enter your password to access the admin panel.</p>
    </div>

    {% for message in app.flashes('error') %}
        <div class="rounded-md bg-destructive/10 px-4 py-3 text-sm text-destructive">{{ message }}</div>
    {% endfor %}

    <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-4 dark:border-amber-800 dark:bg-amber-900/20">
        <div class="flex gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0 text-amber-600 dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <div class="text-sm text-amber-800 dark:text-amber-300">
                <p class="font-semibold">Admin area — elevated privileges</p>
                <p class="mt-1">This confirmation is valid for 15 minutes. All actions taken in the admin panel are recorded in the audit log for SOC2 and PCI DSS compliance.</p>
            </div>
        </div>
    </div>

    <form method="POST" class="space-y-4">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_stepup') }}">

        <div>
            <label for="password" class="block text-sm font-medium text-foreground">Password</label>
            <input id="password" name="password" type="password" required autofocus
                   class="mt-1.5 w-full rounded-md border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring">
        </div>

        <div class="flex gap-3">
            <button type="submit"
                    class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">
                Confirm
            </button>
            <a href="{{ path('auth_logout') }}"
               class="rounded-md border px-4 py-2 text-sm font-medium text-muted-foreground hover:bg-accent/50">
                Sign out
            </a>
        </div>
    </form>
</div>
{% endblock %}
