{% extends 'layouts/admin.html.twig' %}
{% block title %}Audit Log{% endblock %}

{% block admin_content %}
<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-semibold text-foreground">Audit Log</h1>
        <p class="mt-1 text-sm text-muted-foreground">{{ total }} event{{ total != 1 ? 's' : '' }} recorded.</p>
    </div>

    {% if session %}
        <div class="flex items-center gap-3 rounded-md border border-purple-200 bg-purple-50 px-4 py-3 dark:border-purple-800 dark:bg-purple-900/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-purple-600 dark:text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>
            <p class="text-sm text-purple-800 dark:text-purple-300">
                Showing all events for impersonation session <span class="font-mono">{{ session }}</span>
            </p>
            <a href="{{ path('admin_audit_log_index') }}" class="ml-auto text-xs text-purple-600 hover:underline dark:text-purple-400">Clear</a>
        </div>
    {% endif %}

    <form method="GET" class="flex gap-2">
        <input type="hidden" name="session" value="">
        <input type="text" name="action" value="{{ action }}" placeholder="Filter by action prefix…"
               class="flex-1 rounded-md border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring">
        <input type="text" name="actor" value="{{ actor }}" placeholder="Actor UUID…"
               class="w-72 rounded-md border bg-background px-3 py-2 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring">
        <button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">Filter</button>
        {% if action or actor or session %}
            <a href="{{ path('admin_audit_log_index') }}" class="rounded-md border px-4 py-2 text-sm font-medium text-muted-foreground hover:bg-accent/50">Clear</a>
        {% endif %}
    </form>

    <div class="rounded-lg border bg-card">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b">
                    <th class="px-4 py-3 text-left font-medium text-muted-foreground">Action</th>
                    <th class="px-4 py-3 text-left font-medium text-muted-foreground">Actor</th>
                    <th class="px-4 py-3 text-left font-medium text-muted-foreground">Subject</th>
                    <th class="px-4 py-3 text-left font-medium text-muted-foreground">Session</th>
                    <th class="px-4 py-3 text-left font-medium text-muted-foreground">When</th>
                </tr>
            </thead>
            <tbody class="divide-y">
                {% for entry in entries %}
                {% set isImpersonationEvent = entry.action starts with 'impersonation.' %}
                <tr class="hover:bg-muted/30 {{ isImpersonationEvent ? 'bg-purple-50/50 dark:bg-purple-900/10' : '' }}">
                    <td class="px-4 py-2.5 font-mono text-xs text-foreground">{{ entry.action }}</td>
                    <td class="px-4 py-2.5 font-mono text-xs text-muted-foreground">{{ entry.actorId ?: '—' }}</td>
                    <td class="px-4 py-2.5 font-mono text-xs text-muted-foreground">
                        {% if entry.subjectType %}{{ entry.subjectType }}:{% endif %}{{ entry.subjectId ?: '—' }}
                    </td>
                    <td class="px-4 py-2.5 text-xs">
                        {% if entry.impersonationSessionId %}
                            <a href="{{ path('admin_audit_log_index', {session: entry.impersonationSessionId}) }}"
                               class="font-mono text-purple-600 hover:underline dark:text-purple-400"
                               title="View all events in this impersonation session">
                                {{ entry.impersonationSessionId|slice(0, 8) }}…
                            </a>
                        {% else %}
                            <span class="text-muted-foreground">—</span>
                        {% endif %}
                    </td>
                    <td class="px-4 py-2.5 text-xs text-muted-foreground whitespace-nowrap">{{ entry.createdAt|date('Y-m-d H:i:s') }} UTC</td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="px-4 py-8 text-center text-sm text-muted-foreground">
                        No audit log entries found{% if action or actor or session %} matching the current filter{% endif %}.
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if totalPages > 1 %}
    <div class="flex items-center justify-between text-sm">
        <p class="text-muted-foreground">
            Showing {{ ((page - 1) * perPage) + 1 }}–{{ min(page * perPage, total) }} of {{ total }}
        </p>
        <div class="flex gap-2">
            {% if page > 1 %}
                <a href="{{ path('admin_audit_log_index', {page: page - 1, action: action, actor: actor, session: session}) }}"
                   class="rounded-md border px-3 py-1.5 text-muted-foreground hover:bg-accent/50">Previous</a>
            {% endif %}
            {% if page < totalPages %}
                <a href="{{ path('admin_audit_log_index', {page: page + 1, action: action, actor: actor, session: session}) }}"
                   class="rounded-md border px-3 py-1.5 text-muted-foreground hover:bg-accent/50">Next</a>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
