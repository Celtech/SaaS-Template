{% extends 'layouts/admin.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block admin_content %}
<div class="max-w-5xl space-y-6">
    <div>
        <h1 class="text-2xl font-semibold text-foreground">Admin Dashboard</h1>
        <p class="mt-1 text-sm text-muted-foreground">Manage plans, entitlements, and platform settings.</p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="rounded-[10px] border border-border p-5">
            <span class="text-[12.5px] text-muted-foreground">Total users</span>
            <div id="stat-user-count" class="mt-2 text-[28px] font-bold text-foreground">{{ userCount }}</div>
        </div>
        <div class="rounded-[10px] border border-border p-5">
            <span class="text-[12.5px] text-muted-foreground">Total organizations</span>
            <div id="stat-organization-count" class="mt-2 text-[28px] font-bold text-foreground">{{ organizationCount }}</div>
        </div>
        <div class="rounded-[10px] border border-border p-5">
            <span class="text-[12.5px] text-muted-foreground">Active subscriptions</span>
            <div id="stat-active-subscription-count" class="mt-2 text-[28px] font-bold text-foreground">{{ activeSubscriptionCount }}</div>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="{{ path('admin_users_index') }}" class="rounded-lg border bg-card p-5 hover:bg-accent/30 transition-colors">
            <h2 class="font-medium text-foreground">Users</h2>
            <p class="mt-1 text-sm text-muted-foreground">View, suspend, and manage all user accounts.</p>
        </a>
        <a href="{{ path('admin_orgs_index') }}" class="rounded-lg border bg-card p-5 hover:bg-accent/30 transition-colors">
            <h2 class="font-medium text-foreground">Organizations</h2>
            <p class="mt-1 text-sm text-muted-foreground">Browse organizations, members, and subscription status.</p>
        </a>
        <a href="{{ path('admin_plans_index') }}" class="rounded-lg border bg-card p-5 hover:bg-accent/30 transition-colors">
            <h2 class="font-medium text-foreground">Plans</h2>
            <p class="mt-1 text-sm text-muted-foreground">Create and manage subscription plans with Stripe sync.</p>
        </a>
        <a href="{{ path('admin_entitlements_index') }}" class="rounded-lg border bg-card p-5 hover:bg-accent/30 transition-colors">
            <h2 class="font-medium text-foreground">Entitlements</h2>
            <p class="mt-1 text-sm text-muted-foreground">Define feature flags and limits assigned to plans.</p>
        </a>
        <a href="{{ path('admin_billing_settings') }}" class="rounded-lg border bg-card p-5 hover:bg-accent/30 transition-colors">
            <h2 class="font-medium text-foreground">Billing Settings</h2>
            <p class="mt-1 text-sm text-muted-foreground">Configure trial periods, grace periods, and signup defaults.</p>
        </a>
        <a href="{{ path('admin_audit_log_index') }}" class="rounded-lg border bg-card p-5 hover:bg-accent/30 transition-colors">
            <h2 class="font-medium text-foreground">Audit Log</h2>
            <p class="mt-1 text-sm text-muted-foreground">Browse all recorded admin and billing events.</p>
        </a>
    </div>
</div>
{% endblock %}
