{% extends 'layouts/admin.html.twig' %}
{% block title %}Plans{% endblock %}

{% block admin_content %}
<div class="max-w-5xl space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-foreground">Plans</h1>
            <p class="mt-1 text-sm text-muted-foreground">Manage subscription plans. Creating or editing a plan syncs changes to Stripe automatically.</p>
        </div>
        <a href="{{ path('admin_plans_new') }}" class="inline-flex items-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">
            New plan
        </a>
    </div>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="rounded-md px-4 py-3 text-sm {{ type == 'error' ? 'bg-destructive/10 text-destructive' : 'bg-green-50 text-green-800 dark:bg-green-900/20 dark:text-green-400' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="rounded-[10px] border border-border overflow-hidden">
        <table class="w-full text-[13px]">
            <thead>
                <tr class="border-b border-border">
                    <th class="px-4 py-2.5 text-left font-medium text-muted-foreground">Name</th>
                    <th class="px-4 py-2.5 text-left font-medium text-muted-foreground">Slug</th>
                    <th class="px-4 py-2.5 text-right font-medium text-muted-foreground">Monthly</th>
                    <th class="px-4 py-2.5 text-right font-medium text-muted-foreground">Annual</th>
                    <th class="px-4 py-2.5 text-left font-medium text-muted-foreground">Stripe product</th>
                    <th class="px-4 py-2.5 text-center font-medium text-muted-foreground">Status</th>
                    <th class="px-4 py-2.5 text-right font-medium text-muted-foreground">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-muted">
                {% for plan in plans %}
                <tr class="hover:bg-muted/30">
                    <td class="px-4 py-2.5 font-medium text-foreground">
                        {{ plan.name }}
                        {% if plan.free %}<span class="ml-1 text-xs text-muted-foreground">(free)</span>{% endif %}
                    </td>
                    <td class="px-4 py-2.5 font-mono text-xs text-muted-foreground">{{ plan.slug }}</td>
                    <td class="px-4 py-2.5 text-right text-muted-foreground">
                        {% if plan.monthlyPriceCents > 0 %}${{ (plan.monthlyPriceCents / 100)|number_format(2) }}{% else %}—{% endif %}
                    </td>
                    <td class="px-4 py-2.5 text-right text-muted-foreground">
                        {% if plan.annualPriceCents > 0 %}${{ (plan.annualPriceCents / 100)|number_format(2) }}{% else %}—{% endif %}
                    </td>
                    <td class="px-4 py-2.5 font-mono text-xs text-muted-foreground">
                        {{ plan.stripeProductId ?? '—' }}
                    </td>
                    <td class="px-4 py-2.5 text-center">
                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium
                            {{ plan.active ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400' : 'bg-muted text-muted-foreground' }}">
                            {{ plan.active ? 'Active' : 'Inactive' }}
                        </span>
                    </td>
                    <td class="px-4 py-2.5 text-right">
                        <div class="flex items-center justify-end gap-2">
                            <a href="{{ path('admin_plans_entitlements', {id: plan.id}) }}"
                               class="text-xs text-muted-foreground hover:text-foreground">Entitlements</a>
                            <a href="{{ path('admin_plans_edit', {id: plan.id}) }}"
                               class="text-xs text-muted-foreground hover:text-foreground">Edit</a>
                            <form method="POST" action="{{ path('admin_plans_toggle', {id: plan.id}) }}"
                                  onsubmit="return confirm('{{ plan.active ? 'Deactivate' : 'Activate' }} this plan?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('plan_toggle_' ~ plan.id) }}">
                                <button type="submit" class="text-xs {{ plan.active ? 'text-destructive hover:text-destructive/80' : 'text-primary hover:text-primary/80' }}">
                                    {{ plan.active ? 'Deactivate' : 'Activate' }}
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" class="px-4 py-8 text-center text-sm text-muted-foreground">
                        No plans yet. <a href="{{ path('admin_plans_new') }}" class="text-primary hover:underline">Create your first plan.</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
