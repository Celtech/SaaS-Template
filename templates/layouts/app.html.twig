{% extends 'base.html.twig' %}

{% block body %}
{% set banner = trial_banner() %}
<div class="flex h-screen flex-col overflow-hidden">
    {% if is_granted('IS_IMPERSONATOR') %}
        <div class="flex shrink-0 items-center justify-between gap-4 bg-purple-600 px-6 py-2.5 text-sm text-white">
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>
                <p class="font-medium">
                    Admin session — impersonating <strong>{{ app.user.email }}</strong>. All actions are logged.
                </p>
            </div>
            <a href="/?_switch_user=_exit"
               class="shrink-0 rounded-md border border-white/40 px-3 py-1 text-xs font-medium hover:bg-white/10">
                Exit impersonation
            </a>
        </div>
    {% endif %}
    <div class="flex flex-1 overflow-hidden bg-background">
        <twig:Sidebar />
        <div class="flex flex-1 flex-col overflow-hidden">
            <twig:Topbar />

        {% if banner %}
            {% if banner.expired %}
                <div class="flex shrink-0 items-center justify-between gap-4 bg-destructive px-6 py-2.5 text-sm text-destructive-foreground">
                    <p class="font-medium">Your free trial has expired.</p>
                    <a href="{{ path('org_settings_billing') }}"
                       class="shrink-0 rounded-md border border-destructive-foreground/30 px-3 py-1 text-xs font-medium hover:bg-destructive-foreground/10">
                        {{ banner.has_stripe ? 'Manage billing' : 'Add payment method' }}
                    </a>
                </div>
            {% else %}
                <div class="flex shrink-0 items-center justify-between gap-4 bg-amber-500 px-6 py-2.5 text-sm text-white">
                    <p class="font-medium">
                        Your free trial ends in <strong>{{ banner.days_left }} day{{ banner.days_left != 1 ? 's' : '' }}</strong>.
                    </p>
                    <a href="{{ path('org_settings_billing') }}"
                       class="shrink-0 rounded-md border border-white/30 px-3 py-1 text-xs font-medium hover:bg-white/10">
                        {{ banner.has_stripe ? 'Manage billing' : 'Add payment method' }}
                    </a>
                </div>
            {% endif %}
        {% endif %}

        <main class="flex-1 overflow-y-auto px-6 py-8">
            {% block main %}{% endblock %}
        </main>
        </div>
    </div>
</div>
{% endblock %}
