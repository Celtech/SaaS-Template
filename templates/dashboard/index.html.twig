{% extends 'layouts/app.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block main %}
<div class="max-w-5xl space-y-6">
    <div>
        <h1 class="text-2xl font-semibold text-foreground">Dashboard</h1>
        <p class="mt-1 text-sm text-muted-foreground">Welcome back, {{ app.user.name }}.</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-[10px] border border-border p-5">
            <span class="text-[12.5px] text-muted-foreground">Account</span>
            <div class="mt-2 text-lg font-semibold text-foreground">{{ app.user.email }}</div>
        </div>
        <div class="rounded-[10px] border border-border p-5">
            <span class="text-[12.5px] text-muted-foreground">Email verified</span>
            <div class="mt-2 text-lg font-semibold {% if app.user.emailVerified %}text-success{% else %}text-warning{% endif %}">
                {% if app.user.emailVerified %}Verified{% else %}Pending{% endif %}
            </div>
        </div>
        <div class="rounded-[10px] border border-border p-5">
            <span class="text-[12.5px] text-muted-foreground">2FA</span>
            <div class="mt-2 text-lg font-semibold {% if app.user.totpEnabled %}text-success{% else %}text-muted-foreground{% endif %}">
                {% if app.user.totpEnabled %}Enabled{% else %}Disabled{% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock main %}
