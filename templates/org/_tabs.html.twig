{# Props: active ('general'|'billing'), billingEnabled (bool) #}
<div class="flex flex-col gap-0.5">
    <a href="{{ path('org_settings') }}"
       class="rounded-md px-3 py-2 text-[13.5px] transition-colors {{ active == 'general' ? 'bg-muted font-medium text-foreground' : 'text-muted-foreground hover:bg-muted/60' }}">
        General
    </a>
    {% if billingEnabled is defined and billingEnabled %}
        <a href="{{ path('org_settings_billing') }}"
           class="rounded-md px-3 py-2 text-[13.5px] transition-colors {{ active == 'billing' ? 'bg-muted font-medium text-foreground' : 'text-muted-foreground hover:bg-muted/60' }}">
            Billing
        </a>
    {% endif %}
</div>
