{% extends 'layouts/app.html.twig' %}
{% import 'form/field.html.twig' as forms %}

{% block title %}Invite Member{% endblock %}

{% block main %}
<div class="max-w-lg space-y-6">
    <div>
        <h1 class="text-2xl font-semibold text-foreground">Invite a member</h1>
        <p class="mt-1 text-sm text-muted-foreground">Send an invitation to join <strong>{{ org.name }}</strong>.</p>
    </div>

    {% for message in app.flashes('error') %}
        <div class="rounded-lg bg-destructive/10 px-4 py-3 text-sm text-destructive">{{ message }}</div>
    {% endfor %}

    <div class="rounded-xl border bg-card p-6 shadow-sm">
        {{ form_start(form, {'attr': {'class': 'space-y-4', 'novalidate': true}}) }}

            {% if form.vars.errors|length > 0 %}
                <div class="rounded-lg bg-destructive/10 px-4 py-3 text-sm text-destructive">
                    {% for error in form.vars.errors %}
                        <p>{{ error.message }}</p>
                    {% endfor %}
                </div>
            {% endif %}

            {{ forms.field(form.email, {'autocomplete': 'email'}) }}

            <div class="flex items-center justify-between gap-3">
                <a href="{{ path('org_settings') }}" class="text-sm text-muted-foreground hover:underline">Cancel</a>
                <button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">
                    Send invitation
                </button>
            </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
