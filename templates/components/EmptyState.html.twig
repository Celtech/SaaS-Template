{# Props: title, description, icon (optional SVG path d attribute) #}
{% props title = 'No results', description = '', icon = '', class = '' %}
<div class="flex flex-col items-center justify-center py-16 text-center {{ class }}">
    {% if icon %}
        <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-muted">
            <svg class="h-8 w-8 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="{{ icon }}" />
            </svg>
        </div>
    {% endif %}
    <h3 class="text-lg font-semibold text-foreground">{{ title }}</h3>
    {% if description %}
        <p class="mt-1 text-sm text-muted-foreground">{{ description }}</p>
    {% endif %}
    {% if block('actions') is defined %}
        <div class="mt-6">{{ block('actions') }}</div>
    {% endif %}
</div>
