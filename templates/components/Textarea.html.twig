{% props
    placeholder = '',
    name = '',
    id = '',
    rows = 4,
    disabled = false,
    class = ''
%}
<textarea
    {% if placeholder %}placeholder="{{ placeholder }}"{% endif %}
    {% if name %}name="{{ name }}"{% endif %}
    {% if id %}id="{{ id }}"{% endif %}
    rows="{{ rows }}"
    {% if disabled %}disabled{% endif %}
    class="flex min-h-[80px] w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 {{ class }}"
    {{ attributes }}
>{{ block('content') }}</textarea>
