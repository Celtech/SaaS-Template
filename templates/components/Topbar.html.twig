{% props admin = false %}
<header class="flex h-16 shrink-0 items-center justify-between border-b border-border bg-background px-6">
    <div>{% block breadcrumb %}{% endblock %}</div>
    <div class="flex items-center gap-4">
        {% block topbar_actions %}{% endblock %}
        {% if app.user %}
            <div class="relative" data-controller="dropdown">
                <button
                    data-action="dropdown#toggle"
                    class="flex items-center gap-2 rounded-md p-1.5 hover:bg-accent"
                    aria-label="User menu"
                >
                    <twig:Avatar fallback="{{ app.user.email|slice(0,2) }}" size="sm" />
                </button>
                <div data-dropdown-target="menu" hidden class="absolute right-0 top-full mt-1 w-48 rounded-md border border-border bg-popover py-1 shadow-md">
                    <a href="{{ path('app_profile') }}" class="block px-4 py-2 text-sm text-popover-foreground hover:bg-accent">Profile</a>
                    <twig:Separator />
                    <a href="{{ path('app_logout') }}" class="block px-4 py-2 text-sm text-destructive hover:bg-accent">Sign out</a>
                </div>
            </div>
        {% endif %}
    </div>
</header>
