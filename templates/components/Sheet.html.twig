{% props title = '', description = '', side = 'right', class = '' %}
{% set translate = side == 'right' ? 'translate-x-full' : (side == 'left' ? '-translate-x-full' : (side == 'bottom' ? 'translate-y-full' : '-translate-y-full')) %}
{% set position = side == 'right' ? 'right-0 top-0 h-full w-3/4 max-w-sm' : (side == 'left' ? 'left-0 top-0 h-full w-3/4 max-w-sm' : (side == 'bottom' ? 'bottom-0 left-0 w-full' : 'top-0 left-0 w-full')) %}
<div
    data-controller="modal"
    data-modal-target="panel"
    hidden
    class="fixed inset-0 z-50"
    role="dialog"
    aria-modal="true"
>
    <div class="fixed inset-0 bg-black/50" data-action="click->modal#close"></div>
    <div class="fixed {{ position }} border-border bg-background p-6 shadow-lg transition-transform {{ class }}">
        {% if title %}
            <div class="mb-6">
                <h2 class="text-lg font-semibold text-foreground">{{ title }}</h2>
                {% if description %}
                    <p class="mt-1 text-sm text-muted-foreground">{{ description }}</p>
                {% endif %}
            </div>
        {% endif %}
        {% block content %}{% endblock %}
        <button
            type="button"
            data-action="modal#close"
            class="absolute right-4 top-4 rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
            aria-label="Close"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
            </svg>
        </button>
    </div>
</div>
