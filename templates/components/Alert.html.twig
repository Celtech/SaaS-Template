{# variant: 'default' | 'destructive' | 'success' | 'warning' #}
{% props variant = 'default', class = '' %}

{% set variants = {
    default: 'bg-background text-foreground border-border',
    destructive: 'bg-destructive/10 text-destructive border-destructive/50 [&>svg]:text-destructive',
    success: 'bg-success/10 text-success border-success/50 [&>svg]:text-success',
    warning: 'bg-warning/10 text-warning-foreground border-warning/50',
} %}

<div role="alert" class="relative w-full rounded-lg border p-4 [&>svg+div]:translate-y-[-3px] [&>svg]:absolute [&>svg]:left-4 [&>svg]:top-4 [&>svg~*]:pl-7 {{ variants[variant] ?? variants.default }} {{ class }}">
    {{ block('content') }}
</div>
