{# Props: src, alt, fallback (initials), size: 'sm'|'default'|'lg' #}
{% props src = '', alt = '', fallback = '?', size = 'default', class = '' %}

{% set sizes = { sm: 'h-8 w-8 text-xs', default: 'h-10 w-10 text-sm', lg: 'h-14 w-14 text-base' } %}

<span class="relative flex shrink-0 overflow-hidden rounded-full {{ sizes[size] ?? sizes.default }} {{ class }}">
    {% if src %}
        <img src="{{ src }}" alt="{{ alt }}" class="aspect-square h-full w-full object-cover">
    {% else %}
        <span class="flex h-full w-full items-center justify-center rounded-full bg-muted font-medium text-muted-foreground">
            {{ fallback|upper|slice(0, 2) }}
        </span>
    {% endif %}
</span>
