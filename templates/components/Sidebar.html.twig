{# Props: admin (bool) — renders admin nav vs user nav #}
{% props admin = false %}
{% set collapsed = app.request.cookies.get('sidebar_collapsed') == '1' %}
<aside
    data-controller="sidebar"
    data-sidebar-collapsed-value="{{ collapsed ? 'true' : 'false' }}"
    class="flex h-full {{ collapsed ? 'w-[72px]' : 'w-[236px]' }} shrink-0 flex-col overflow-hidden border-r border-sidebar-border bg-sidebar-background transition-[width] duration-200"
>
    <div class="flex h-16 items-center border-b border-sidebar-border px-4">
        <a href="{{ admin ? path('admin_dashboard') : path('app_dashboard') }}" class="flex items-center gap-2 overflow-hidden">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-primary text-sm font-bold text-primary-foreground">
                {{ (app_name|default('SaaS Template'))|slice(0, 1) }}
            </span>
            <span data-sidebar-target="label" class="truncate text-base font-bold whitespace-nowrap text-sidebar-foreground {{ collapsed ? 'hidden' : '' }}">
                {{ app_name|default('SaaS Template') }}
                {% if admin %}
                    <span class="ml-1 text-xs font-normal text-sidebar-foreground/60">Admin</span>
                {% endif %}
            </span>
        </a>
    </div>
    <nav class="flex-1 overflow-y-auto px-3 py-4">
        {% if admin %}
            {% block admin_nav %}
                {% set cr = app.request.attributes.get('_route') %}

                <p data-sidebar-target="label" class="mb-2 px-2 text-xs font-semibold whitespace-nowrap uppercase tracking-wider text-sidebar-foreground/50 {{ collapsed ? 'hidden' : '' }}">People</p>
                <div class="mb-4 space-y-1">
                    <a href="{{ path('admin_users_index') }}" title="Users" data-sidebar-target="navItem"
                       class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors {{ collapsed ? 'justify-center' : '' }}
                           {{ cr starts with 'admin_users' ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground hover:bg-sidebar-accent/50' }}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <span data-sidebar-target="label" class="whitespace-nowrap {{ collapsed ? 'hidden' : '' }}">Users</span>
                    </a>
                    <a href="{{ path('admin_orgs_index') }}" title="Organizations" data-sidebar-target="navItem"
                       class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors {{ collapsed ? 'justify-center' : '' }}
                           {{ cr starts with 'admin_orgs' ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground hover:bg-sidebar-accent/50' }}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
                        <span data-sidebar-target="label" class="whitespace-nowrap {{ collapsed ? 'hidden' : '' }}">Organizations</span>
                    </a>
                </div>

                <p data-sidebar-target="label" class="mb-2 px-2 text-xs font-semibold whitespace-nowrap uppercase tracking-wider text-sidebar-foreground/50 {{ collapsed ? 'hidden' : '' }}">Billing</p>
                <div class="mb-4 space-y-1">
                    <a href="{{ path('admin_plans_index') }}" title="Plans" data-sidebar-target="navItem"
                       class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors {{ collapsed ? 'justify-center' : '' }}
                           {{ cr starts with 'admin_plans' ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground hover:bg-sidebar-accent/50' }}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
                        <span data-sidebar-target="label" class="whitespace-nowrap {{ collapsed ? 'hidden' : '' }}">Plans</span>
                    </a>
                    <a href="{{ path('admin_entitlements_index') }}" title="Entitlements" data-sidebar-target="navItem"
                       class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors {{ collapsed ? 'justify-center' : '' }}
                           {{ cr starts with 'admin_entitlements' ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground hover:bg-sidebar-accent/50' }}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
                        <span data-sidebar-target="label" class="whitespace-nowrap {{ collapsed ? 'hidden' : '' }}">Entitlements</span>
                    </a>
                    <a href="{{ path('admin_billing_settings') }}" title="Settings" data-sidebar-target="navItem"
                       class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors {{ collapsed ? 'justify-center' : '' }}
                           {{ cr == 'admin_billing_settings' ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground hover:bg-sidebar-accent/50' }}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                        <span data-sidebar-target="label" class="whitespace-nowrap {{ collapsed ? 'hidden' : '' }}">Settings</span>
                    </a>
                </div>

                <p data-sidebar-target="label" class="mb-2 px-2 text-xs font-semibold whitespace-nowrap uppercase tracking-wider text-sidebar-foreground/50 {{ collapsed ? 'hidden' : '' }}">System</p>
                <div class="mb-4 space-y-1">
                    <a href="{{ path('admin_audit_log_index') }}" title="Audit Log" data-sidebar-target="navItem"
                       class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors {{ collapsed ? 'justify-center' : '' }}
                           {{ cr starts with 'admin_audit_log' ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground hover:bg-sidebar-accent/50' }}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
                        <span data-sidebar-target="label" class="whitespace-nowrap {{ collapsed ? 'hidden' : '' }}">Audit Log</span>
                    </a>
                    <a href="{{ path('admin_webhooks_index') }}" title="Webhooks" data-sidebar-target="navItem"
                       class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors {{ collapsed ? 'justify-center' : '' }}
                           {{ cr starts with 'admin_webhooks' ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground hover:bg-sidebar-accent/50' }}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 17H7A5 5 0 0 1 7 7h2"/><path d="M15 7h2a5 5 0 1 1 0 10h-2"/><line x1="8" x2="16" y1="12" y2="12"/></svg>
                        <span data-sidebar-target="label" class="whitespace-nowrap {{ collapsed ? 'hidden' : '' }}">Webhooks</span>
                    </a>
                </div>
            {% endblock %}
        {% else %}
            {% block app_nav %}
                {% set currentRoute = app.request.attributes.get('_route') %}
                <div class="space-y-1">
                    <a href="{{ path('app_dashboard') }}" title="Dashboard" data-sidebar-target="navItem"
                       class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors {{ collapsed ? 'justify-center' : '' }}
                           {{ currentRoute == 'app_dashboard' ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground hover:bg-sidebar-accent/50 hover:text-sidebar-accent-foreground' }}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
                        <span data-sidebar-target="label" class="whitespace-nowrap {{ collapsed ? 'hidden' : '' }}">Dashboard</span>
                    </a>
                    {% if app.user and app.user.organization %}
                        <a href="{{ path('org_settings') }}" title="Organization" data-sidebar-target="navItem"
                           class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors {{ collapsed ? 'justify-center' : '' }}
                               {{ currentRoute starts with 'org_' ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground hover:bg-sidebar-accent/50 hover:text-sidebar-accent-foreground' }}">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            <span data-sidebar-target="label" class="whitespace-nowrap {{ collapsed ? 'hidden' : '' }}">Organization</span>
                        </a>
                    {% endif %}
                    <a href="{{ path('profile_index') }}" title="Profile" data-sidebar-target="navItem"
                       class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors {{ collapsed ? 'justify-center' : '' }}
                           {{ currentRoute starts with 'profile_' ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground hover:bg-sidebar-accent/50 hover:text-sidebar-accent-foreground' }}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>
                        <span data-sidebar-target="label" class="whitespace-nowrap {{ collapsed ? 'hidden' : '' }}">Profile</span>
                    </a>
                    <a href="{{ path('developer_index') }}" title="Developer" data-sidebar-target="navItem"
                       class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors {{ collapsed ? 'justify-center' : '' }}
                           {{ currentRoute starts with 'developer_' ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground hover:bg-sidebar-accent/50 hover:text-sidebar-accent-foreground' }}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                        <span data-sidebar-target="label" class="whitespace-nowrap {{ collapsed ? 'hidden' : '' }}">Developer</span>
                    </a>
                </div>
            {% endblock %}
        {% endif %}
    </nav>
    <div class="border-t border-sidebar-border p-2">
        <button type="button" data-action="sidebar#toggle" data-sidebar-target="navItem"
                class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-sidebar-foreground/70 transition-colors hover:bg-sidebar-accent/50 hover:text-sidebar-foreground {{ collapsed ? 'justify-center' : '' }}">
            <svg data-sidebar-target="chevron" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 transition-transform duration-200 {{ collapsed ? 'rotate-180' : '' }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
            <span data-sidebar-target="label" class="whitespace-nowrap {{ collapsed ? 'hidden' : '' }}">Collapse</span>
        </button>
    </div>
    <div class="border-t border-sidebar-border p-4">
        {% if app.user %}
            <div class="flex items-center gap-3 {{ collapsed ? 'justify-center' : '' }}" data-sidebar-target="navItem">
                <twig:Avatar fallback="{{ app.user.email|slice(0,2) }}" size="sm" />
                <div data-sidebar-target="label" class="min-w-0 flex-1 {{ collapsed ? 'hidden' : '' }}">
                    <p class="truncate text-sm font-medium text-sidebar-foreground">{{ app.user.email }}</p>
                </div>
            </div>
        {% endif %}
    </div>
</aside>
