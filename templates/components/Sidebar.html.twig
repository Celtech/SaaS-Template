{# Props: admin (bool) — renders admin nav vs user nav #}
{% props admin = false %}
<aside class="flex h-full w-64 flex-col border-r border-sidebar-border bg-sidebar-background">
    <div class="flex h-16 items-center border-b border-sidebar-border px-6">
        <a href="{{ admin ? path('admin_dashboard') : path('app_dashboard') }}" class="text-lg font-bold text-sidebar-foreground">
            {{ app_name|default('SaaS Template') }}
            {% if admin %}
                <span class="ml-2 text-xs font-normal text-sidebar-foreground/60">Admin</span>
            {% endif %}
        </a>
    </div>
    <nav class="flex-1 overflow-y-auto px-4 py-4">
        {% if admin %}
            {% block admin_nav %}
                {% set cr = app.request.attributes.get('_route') %}

                <p class="mb-2 px-2 text-xs font-semibold uppercase tracking-wider text-sidebar-foreground/50">People</p>
                <div class="space-y-1 mb-4">
                    <a href="{{ path('admin_users_index') }}"
                       class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors
                           {{ cr starts with 'admin_users' ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground hover:bg-sidebar-accent/50' }}">
                        Users
                    </a>
                </div>

                <p class="mb-2 px-2 text-xs font-semibold uppercase tracking-wider text-sidebar-foreground/50">Billing</p>
                <div class="space-y-1 mb-4">
                    <a href="{{ path('admin_plans_index') }}"
                       class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors
                           {{ cr starts with 'admin_plans' ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground hover:bg-sidebar-accent/50' }}">
                        Plans
                    </a>
                    <a href="{{ path('admin_entitlements_index') }}"
                       class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors
                           {{ cr starts with 'admin_entitlements' ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground hover:bg-sidebar-accent/50' }}">
                        Entitlements
                    </a>
                </div>
            {% endblock %}
        {% else %}
            {% block app_nav %}
                {% set currentRoute = app.request.attributes.get('_route') %}
                <div class="space-y-1">
                    <a href="{{ path('app_dashboard') }}"
                       class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors
                           {{ currentRoute == 'app_dashboard' ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground hover:bg-sidebar-accent/50 hover:text-sidebar-accent-foreground' }}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
                        Dashboard
                    </a>
                    {% if app.user and app.user.organization %}
                        <a href="{{ path('org_settings') }}"
                           class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors
                               {{ currentRoute starts with 'org_' ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground hover:bg-sidebar-accent/50 hover:text-sidebar-accent-foreground' }}">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            Organization
                        </a>
                    {% endif %}
                    <a href="{{ path('profile_index') }}"
                       class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium transition-colors
                           {{ currentRoute starts with 'profile_' ? 'bg-sidebar-accent text-sidebar-accent-foreground' : 'text-sidebar-foreground hover:bg-sidebar-accent/50 hover:text-sidebar-accent-foreground' }}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>
                        Profile
                    </a>
                </div>
            {% endblock %}
        {% endif %}
    </nav>
    <div class="border-t border-sidebar-border p-4">
        {% if app.user %}
            <div class="flex items-center gap-3">
                <twig:Avatar fallback="{{ app.user.email|slice(0,2) }}" size="sm" />
                <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-medium text-sidebar-foreground">{{ app.user.email }}</p>
                </div>
            </div>
        {% endif %}
    </div>
</aside>
