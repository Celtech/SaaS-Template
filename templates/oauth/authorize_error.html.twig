{% extends 'layouts/app.html.twig' %}

{% block title %}Authorization error{% endblock %}

{% block main %}
<div class="max-w-md mx-auto">
    <div class="rounded-lg border border-dashed border-border bg-card p-12 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-10 w-10 text-destructive/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <p class="mt-4 text-sm font-medium text-foreground">Authorization request could not be completed</p>
        <p class="mt-1 text-sm text-muted-foreground">{{ message }}</p>
    </div>
</div>
{% endblock %}
