{% extends 'layouts/auth.html.twig' %}

{% block title %}Two-factor authentication{% endblock %}

{% block auth_content %}
<div class="rounded-xl border bg-card p-8 shadow-sm">
    <div class="mb-6 text-center">
        <h1 class="text-2xl font-semibold text-card-foreground">Two-factor authentication</h1>
        <p class="mt-1 text-sm text-muted-foreground">
            Enter the 6-digit code we sent to your email address
        </p>
    </div>

    {% if authenticationError is defined and authenticationError %}
        <div class="mb-4 rounded-lg bg-destructive/10 px-4 py-3 text-sm text-destructive">
            The code you entered is incorrect. Please check your email and try again.
        </div>
    {% endif %}

    <form method="post" action="{{ path('2fa_login_check') }}" class="space-y-4">

        <div class="space-y-1">
            <label for="_auth_code" class="block text-sm font-medium text-foreground">Email code</label>
            <input
                type="text"
                id="_auth_code"
                name="_auth_code"
                inputmode="numeric"
                pattern="[0-9]{6}"
                maxlength="6"
                autocomplete="one-time-code"
                autofocus
                required
                placeholder="000000"
                class="w-full rounded-md border border-input bg-background px-3 py-2 text-center text-lg tracking-widest focus:outline-none focus:ring-2 focus:ring-ring"
            >
        </div>

        <button
            type="submit"
            class="w-full rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
        >
            Verify
        </button>

    </form>

    <div class="mt-3 text-center">
        <form method="post" action="{{ path('2fa_resend_code') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('2fa_resend') }}">
            <button
                type="submit"
                id="resend-btn"
                data-cooldown="{{ resendCooldown is defined ? resendCooldown : 0 }}"
                {% if resendCooldown is defined and resendCooldown > 0 %}disabled{% endif %}
                class="text-sm font-medium text-primary hover:underline disabled:text-muted-foreground disabled:cursor-not-allowed"
            >
                {% if resendCooldown is defined and resendCooldown > 0 %}
                    Resend code ({{ resendCooldown }}s)
                {% else %}
                    Resend code
                {% endif %}
            </button>
        </form>
    </div>

    <script>
    (function () {
        var btn = document.getElementById('resend-btn');
        if (!btn) return;
        var remaining = parseInt(btn.dataset.cooldown || '0', 10);
        if (remaining <= 0) return;
        function tick() {
            remaining--;
            if (remaining <= 0) {
                btn.disabled = false;
                btn.textContent = 'Resend code';
            } else {
                btn.textContent = 'Resend code (' + remaining + 's)';
                setTimeout(tick, 1000);
            }
        }
        setTimeout(tick, 1000);
    })();
    </script>

    {% if availableTwoFactorProviders is defined and availableTwoFactorProviders|length > 1 %}
        <div class="mt-4 text-center text-sm text-muted-foreground">
            <a href="{{ path('2fa_select_provider') }}" class="font-medium text-primary hover:underline">
                Verify another way
            </a>
        </div>
    {% endif %}

    <p class="mt-4 text-center text-sm text-muted-foreground">
        <a href="{{ path('auth_logout') }}" class="font-medium text-primary hover:underline">Sign in as different user</a>
    </p>
</div>
{% endblock %}
