{% extends 'layouts/auth.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block auth_content %}
<div class="rounded-xl border bg-card p-8 shadow-sm">
    <div class="mb-6 text-center">
        <h1 class="text-2xl font-semibold text-card-foreground">Welcome back</h1>
        <p class="mt-1 text-sm text-muted-foreground">Sign in to your account</p>
    </div>

    {% for message in app.flashes('success') %}
        <div class="mb-4 rounded-lg bg-success/10 px-4 py-3 text-sm text-success">{{ message }}</div>
    {% endfor %}

    {% if error %}
        {% if error.messageKey == 'email_not_verified' %}
            <div class="mb-4 rounded-lg bg-warning/10 px-4 py-3 text-sm text-warning">
                <p class="font-medium">Your email address hasn't been verified yet.</p>
                <form method="post" action="{{ path('auth_resend_verification') }}" class="mt-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('resend_verification') }}">
                    <input type="hidden" name="email" value="{{ last_username }}">
                    <input type="hidden" name="redirect_to" value="auth_login">
                    <button type="submit" class="font-medium underline hover:no-underline">
                        Resend verification email
                    </button>
                </form>
            </div>
        {% elseif error.messageKey == 'account_inactive' %}
            <div class="mb-4 rounded-lg bg-warning/10 px-4 py-3 text-sm text-warning">
                <p class="font-medium">Your account is not active.</p>
                <p class="mt-1">Please contact support if you believe this is an error.</p>
            </div>
        {% else %}
            <div class="mb-4 rounded-lg bg-destructive/10 px-4 py-3 text-sm text-destructive">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}
    {% endif %}

    <form method="post" action="{{ path('auth_login') }}" class="space-y-4">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="space-y-1">
            <label for="email" class="block text-sm font-medium text-foreground">Email address</label>
            <input
                type="email"
                id="email"
                name="email"
                value="{{ last_username }}"
                autocomplete="email"
                autofocus
                required
                class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
            >
        </div>

        <div class="space-y-1">
            <div class="flex items-center justify-between">
                <label for="password" class="block text-sm font-medium text-foreground">Password</label>
                <a href="{{ path('auth_forgot_password') }}" class="text-sm text-primary hover:underline">
                    Forgot password?
                </a>
            </div>
            <input
                type="password"
                id="password"
                name="password"
                autocomplete="current-password"
                required
                class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
            >
        </div>

        <div class="flex items-center gap-2">
            <input type="checkbox" id="remember_me" name="_remember_me" class="rounded border-input">
            <label for="remember_me" class="text-sm text-muted-foreground">Remember me for 30 days</label>
        </div>

        <button
            type="submit"
            class="w-full rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
        >
            Sign in
        </button>
    </form>

    <p class="mt-6 text-center text-sm text-muted-foreground">
        Don't have an account?
        <a href="{{ path('auth_register') }}" class="font-medium text-primary hover:underline">Create one</a>
    </p>
</div>
{% endblock %}
