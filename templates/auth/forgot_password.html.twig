{% extends 'layouts/auth.html.twig' %}

{% block title %}Forgot password{% endblock %}

{% block auth_content %}
<div class="rounded-xl border bg-card p-8 shadow-sm">
    <div class="mb-6 text-center">
        <h1 class="text-2xl font-semibold text-card-foreground">Reset your password</h1>
        <p class="mt-1 text-sm text-muted-foreground">
            Enter your email and we'll send you a reset link
        </p>
    </div>

    {{ form_start(form, {'attr': {'class': 'space-y-4', 'novalidate': true}}) }}

        <div class="space-y-1">
            {{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground'}}) }}
            {{ form_widget(form.email, {'attr': {'class': 'w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-ring', 'autocomplete': 'email', 'autofocus': true}}) }}
            {{ form_errors(form.email) }}
        </div>

        <button
            type="submit"
            class="w-full rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
        >
            Send reset link
        </button>

    {{ form_end(form) }}

    <p class="mt-6 text-center text-sm text-muted-foreground">
        <a href="{{ path('auth_login') }}" class="font-medium text-primary hover:underline">Back to sign in</a>
    </p>
</div>
{% endblock %}
