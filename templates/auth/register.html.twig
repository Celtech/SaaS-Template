{% extends 'layouts/auth.html.twig' %}
{% import 'form/field.html.twig' as forms %}

{% block title %}Create account{% endblock %}

{% block auth_content %}
<div class="rounded-xl border bg-card p-8 shadow-sm">
    <div class="mb-6 text-center">
        <h1 class="text-2xl font-semibold text-card-foreground">Create your account</h1>
        {% if invitation %}
            <p class="mt-1 text-sm text-muted-foreground">You've been invited to join <strong>{{ invitation.organization.name }}</strong>.</p>
        {% else %}
            <p class="mt-1 text-sm text-muted-foreground">Get started for free</p>
        {% endif %}
    </div>

    {{ form_start(form, {'attr': {'class': 'space-y-4', 'novalidate': true}}) }}

        {% if form.vars.errors|length > 0 %}
            <div class="rounded-lg bg-destructive/10 px-4 py-3 text-sm text-destructive">
                {% for error in form.vars.errors %}
                    <p>{{ error.message }}</p>
                {% endfor %}
            </div>
        {% endif %}

        {{ forms.field(form.name, {'autocomplete': 'name'}) }}
        {{ forms.field(form.email, {'autocomplete': 'email'}) }}
        {{ forms.field(form.plainPassword.first, {'autocomplete': 'new-password'}) }}
        {{ forms.field(form.plainPassword.second, {'autocomplete': 'new-password'}) }}

        {# Checkbox with manual error rendering since layout differs #}
        <div class="space-y-1">
            <div class="flex items-center gap-2">
                {{ form_widget(form.agreeTerms, {'attr': {'class': 'rounded border-input'}}) }}
                {{ form_label(form.agreeTerms, null, {'label_attr': {'class': 'text-sm ' ~ (form.agreeTerms.vars.errors|length > 0 ? 'text-destructive' : 'text-muted-foreground')}}) }}
            </div>
            {{ form_errors(form.agreeTerms) }}
        </div>

        <button
            type="submit"
            class="w-full rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
        >
            Create account
        </button>

    {{ form_end(form) }}

    <p class="mt-6 text-center text-sm text-muted-foreground">
        Already have an account?
        <a href="{{ path('auth_login') }}" class="font-medium text-primary hover:underline">Sign in</a>
    </p>
</div>
{% endblock %}
