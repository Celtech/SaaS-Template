<turbo-frame id="notification-bell" data-controller="notification-poll" data-notification-poll-interval-value="30000">
    <div class="relative" data-controller="dropdown">
        <button
            data-action="dropdown#toggle"
            class="relative flex items-center"
            aria-label="Notifications{{ unreadCount > 0 ? ' (' ~ unreadCount ~ ' unread)' : '' }}"
        >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-[17px] w-[17px] text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
                <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
            </svg>
            {% if unreadCount > 0 %}
                <span class="absolute -top-0.5 -right-0.5 flex h-[7px] min-w-[7px] items-center justify-center rounded-full border-[1.5px] border-background bg-primary"></span>
            {% endif %}
        </button>
        <div data-dropdown-target="menu" hidden class="absolute right-0 top-full z-10 mt-1 w-80 rounded-md border border-border bg-popover shadow-[0_8px_24px_rgba(0,0,0,0.1)]">
            <turbo-frame id="notification-dropdown" src="{{ path('notifications_dropdown') }}" loading="lazy">
                <div class="p-4 text-sm text-muted-foreground">Loading…</div>
            </turbo-frame>
        </div>
    </div>
</turbo-frame>
